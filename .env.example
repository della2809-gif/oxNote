NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-only. Never prefix this key with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

OPENAI_API_KEY=
OPENAI_FAST_MODEL=gpt-5.6-luna
OPENAI_FILE_MODEL=gpt-5.6-terra
OPENAI_REASONING_MODEL=gpt-5.6-sol
OPENAI_REASONING_EFFORT=high
OPENAI_FILE_REASONING_EFFORT=low
OPENAI_FILE_VERBOSITY=medium
OPENAI_IMAGE_DETAIL=high
OPENAI_ANALYSIS_VERSION=2026-08-09-v1

# Backward-compatible aliases. New deployments should prefer the role-based variables above.
OPENAI_MODEL=
OPENAI_ANALYSIS_MODEL=

# Support inquiry email notification (server-only).
RESEND_API_KEY=
SUPPORT_NOTIFICATION_TO=
SUPPORT_NOTIFICATION_FROM=xonote <support@xonote.com>

# Member rollout for performance benchmarking is controlled in the admin console.
# It is disabled by default in product_feature_flags.

# Optional hosted checkout page supplied by the selected payment provider.
PAYMENT_CHECKOUT_URL=
